<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@wallet.css, @collectibles.css, @../general.css" styleClass="wallet-pane" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.sparrowwallet.sparrow.wallet.CollectiblesController">
    <padding>
        <Insets top="15.0" left="25.0" right="25.0" bottom="15.0" />
    </padding>
    <top>
        <VBox spacing="8">
            <padding>
                <Insets bottom="10.0" />
            </padding>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Collectibles" styleClass="collectibles-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="refreshButton" text="Refresh" />
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label fx:id="statusLabel" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                <Button fx:id="preferencesButton" text="Open Preferences" />
            </HBox>
        </VBox>
    </top>
    <center>
        <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Inscriptions">
                <BorderPane>
                    <center>
                        <ScrollPane fitToWidth="true">
                            <TilePane fx:id="inscriptionTiles" hgap="12" vgap="12" prefColumns="4">
                                <padding>
                                    <Insets top="10.0" left="10.0" right="10.0" bottom="10.0" />
                                </padding>
                            </TilePane>
                        </ScrollPane>
                    </center>
                    <right>
                        <VBox fx:id="detailPane" spacing="6" prefWidth="300" styleClass="inscription-detail">
                            <padding>
                                <Insets top="10.0" left="15.0" right="5.0" bottom="10.0" />
                            </padding>
                        </VBox>
                    </right>
                </BorderPane>
            </Tab>
            <Tab text="Runes">
                <TableView fx:id="runesTable" />
            </Tab>
        </TabPane>
    </center>
    <bottom>
        <Label fx:id="emptyLabel" wrapText="true">
            <padding>
                <Insets top="10.0" />
            </padding>
        </Label>
    </bottom>
</BorderPane>
