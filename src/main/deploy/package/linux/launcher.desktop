[Desktop Entry]
Name=${appName}
Comment=${appName}
Exec=/opt/${package}/bin/${launcher} %U
Icon=/opt/${package}/lib/${launcher}.png
Terminal=false
Type=Application
Categories=Finance;Network;
MimeType=application/psbt;application/litecoin-transaction;application/pgp-signature;x-scheme-handler/litecoin;x-scheme-handler/auth47;x-scheme-handler/lightning
StartupWMClass=${appName}
SingleMainWindow=true
